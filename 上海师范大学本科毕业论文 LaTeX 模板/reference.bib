# 把你的引用文献的 bibTex 放在这里, 这里给出一些不同的类型, 用以参考以及展示

# Milne 的在线笔记, 你可以从它笔记的附录里面找到它自己写的 bib, 
这里我建议您使用 online 而非 misc
@online{milneAV,
author={Milne, James S.},
title={Abelian Varieties (v2.00)},
year={2008},
note={Available at www.jmilne.org/math/},
pages={166+vi}
}

# Hartshorne 的原版书, Mathscinet 上找到的 bib
@book{Hartshorne1977,
  author     = {Hartshorne, Robin},
  title      = {Algebraic geometry},
  series     = {Graduate Texts in Mathematics},
  volume     = {No. 52},
  publisher  = {Springer-Verlag, New York-Heidelberg},
  year       = {1977},
  pages      = {xvi+496},
  isbn       = {0-387-90244-9},
  mrclass    = {14-01},
  mrnumber   = {463157},
  mrreviewer = {Robert\ Speiser}
}

# 黎景辉的中文书
@book{Lai2006,
  title     = {代数群引论},
  author    = {黎景辉 and 陈志杰 and 赵春来},
  publisher = {科学出版社},
  address   = {北京},
  year      = {2006},
  language  = {Chinese}
}

# Grothendieck 的书周健的中译本, 原作者直接用中文译名
@book{EGAChinese1,
  title={代数几何学原理. I, 概形语言},
  origtitle = {Éléments de géométrie algébrique: I. Le langage des schémas},
  author={格罗滕迪克},
  translater={周健},
  publisher={高等教育出版社},
  address = {北京},
  year={2018},
}

